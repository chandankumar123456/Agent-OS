# =============================================================================
# AgentOS Environment Configuration Example
# Copy this file to `.env` and fill in your actual values.
# =============================================================================

# ------------------------------------------------------------------------------
# REQUIRED: Core Application
# ------------------------------------------------------------------------------

# OpenAI Configuration (required for LLM operations)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Database Configuration (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://agentos:agentos@localhost:5432/agentos

# Redis Configuration (cache + pub/sub event bus)
REDIS_URL=redis://localhost:6379/0

# Security — MUST be identical across all processes (FastAPI, Celery, runtime)
# Minimum 32 bytes recommended
SECRET_KEY=your-secret-key-min-32-bytes-long-change-in-production!!!

# ------------------------------------------------------------------------------
# OPTIONAL: Additional LLM Providers
# ------------------------------------------------------------------------------

# Anthropic Claude (optional — enables Claude models)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini (optional — enables Gemini models)
# GOOGLE_API_KEY=your-google-api-key

# Ollama (optional — for local model hosting)
# OLLAMA_BASE_URL=http://localhost:11434

# Comma-separated list of enabled provider names
# ENABLED_PROVIDERS=openai,anthropic,google,ollama

# EXA Search API (optional — for web search capabilities)
# EXA_API_KEY=your-exa-api-key

# ------------------------------------------------------------------------------
# OPTIONAL: Application Tuning
# ------------------------------------------------------------------------------

MAX_STEPS_DEFAULT=10
TIMEOUT_DEFAULT=300
MAX_RETRIES=3

# API route prefix (default: /api/v1)
API_V1_PREFIX=/api/v1

# CORS origins — comma-separated. Use * for all (disables credentials).
# For local dev with frontend on port 5173:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,http://localhost:4173

# Celery background task queue (optional)
# USE_CELERY=false

# API key authentication for external integrations (optional)
# API_KEYS=your-api-key-here

# Rate limiting (requests per minute, optional)
# RATE_LIMIT_PER_MINUTE=60

# Concurrency limits (optional)
# MAX_ACTIVE_TASKS_PER_USER=10
# MAX_TASK_EXECUTION_ATTEMPTS=3

# JWT Configuration (optional — defaults shown)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# OPTIONAL: PostgreSQL credentials (used by docker-compose and some scripts)
# ------------------------------------------------------------------------------
POSTGRES_USER=agentos
POSTGRES_PASSWORD=agentos
POSTGRES_DB=agentos

# ------------------------------------------------------------------------------
# FRONTEND (create a separate .env inside the frontend/ directory)
# ------------------------------------------------------------------------------
# VITE_API_URL=http://localhost:8000/api/v1
# VITE_WS_URL=ws://localhost:8000
